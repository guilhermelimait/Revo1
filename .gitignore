# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Firmware build output and downloaded components (restored by the build)
firmware/.pio/
firmware/managed_components/
firmware/build/
firmware/sdkconfig.old

# Release artefacts and flash dumps (a dump contains the vendor's firmware)
dist/
build/
backups/
*.bin
*.elf

# Development-only files, kept out of the public repository
tests/
install.ps1

# Secrets and local settings: never commit these
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*secret*
*credential*
settings.json
*.log

# Editors and OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
